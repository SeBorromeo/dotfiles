;; homerow mods
(defalias
  a (t! shiftmod a lsft)
  s (t! charmod s lctl)
  dstb (t! charmod S-tab lalt)
  ftb (t! charmod tab lmet)

  j (t! charmod j rmet)
  k (t! charmod k ralt)
  l (t! charmod l rctl)
  ; (t! shiftmod ; rsft)
)
    
(deflayer nav                          
  _    _    _    _       _    _    _    _    _    _    _    _    _    _
  _    _    _    C-S-tab C-tab _    _    home pgup end  _    _    _    _
  _    @a   @s   @dstb   @ftb _    left down up   rght _    _    _
  _    _    _    _        _    _    _    _    pgdn _    _    _
  _    _    _                  _              _    _    _    _  
)
