(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

(defalias
  num-lock (layer-switch num)
)

(deftemplate charmod (char mod)
  (switch 
    ((key-timing 3 less-than 225)) $char break
    () (tap-hold-release 180 400 $char $mod) break
  )
)

(deftemplate shiftmod (char mod)
  (switch 
    ((and
     (key-timing 2 less-than 250)
     (not (key-history spc 1))
    )) $char break 
    () (tap-hold-release 0 160 $char $mod) break
  )
)

(deftemplate rsftmod (char mod)
  (tap-hold-release 0 140 $char $mod)
)

(deflayermap (main)
  ;; homerow mods
  a (t! shiftmod a lsft)
  s (t! charmod s lctl)
  d (t! charmod d lalt)
  f (t! charmod f lmet)

  j (t! charmod j rmet)
  k (t! charmod k ralt) 
  l (t! charmod l rctl)
  ; (t! rsftmod ' rsft)

  ;; caps num
  ;; caps bspc
  caps (tap-hold 0 200 bspc (layer-while-held num))
  
  ;; function layer
  ' (tap-hold 0 200 @num-lock (layer-while-held fun))

  ;; nav layer
  lsft (tap-hold 0 150 (one-shot 2000 lsft) (layer-while-held nav))
  rsft (tap-hold 0 120 esc (layer-while-held nav))
  / (tap-hold 0 180 / (layer-while-held nav))

  ;; symbol layer
  spc (tap-hold 0 200 spc (layer-while-held sym))
)

;; defines a vkey named v-$key, example v-bspc
;; and an alias @v-bspc that press and and releases the v-key
;; within on-press and on-release respectively.
(deftemplate v- (key)
  (defvirtualkeys (concat v- $key) $key)
  (defalias (concat v- $key)
    (multi (on-press press-vkey (concat v- $key)) (on-release release-vkey (concat v- $key))))
)

(t! v- ret)
(defchordsv2
  (d f) @v-ret 50 first-release (nav)

  (q w) t 50 first-release ()

  (s d) esc 35 first-release (nav)

  (a ;) (caps-word-custom-toggle 2000
    (a b c d e f g h i j k l m n o p q r s t u v w x y z -)
    (bspc del up down left rght lsft rsft)
  ) 50 all-released () 
   
  ;; gaming toggle
  (lctl rctl)
    (switch
      ((layer gaming)) (layer-switch main) break
      () (layer-switch gaming) break
    )
    20 first-release ()

  (q p) lrld 20 first-release ()
)

(include "nav-layer.kbd")
(include "sym-layer.kbd")
(include "gaming-layer.kbd")
(include "function-layer.kbd")
(include "num-layer.kbd")