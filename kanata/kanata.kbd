(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

(deftemplate charmod (char mod)
  (switch 
    ((key-timing 3 less-than 350)) $char break
    () (tap-hold-release 180 500 $char $mod) break
  )
)

(deftemplate shiftmod (char mod)
  (switch 
    ;; ((key-timing 3 less-than 150)) $char break
    () (tap-hold-release 0 200 $char $mod) break
  )
)

(deflayermap (main)
  ;; homerow mods
  a (t! shiftmod a lsft)
  s (t! charmod s lctl)
  d (t! charmod d lalt)
  f (t! charmod f lmet)

  j (t! charmod j rmet)
  k (t! charmod k ralt) 
  l (t! charmod l rctl)
  ; (t! shiftmod ' rsft)

  ;; unbinding some keys for now
  bspc XX
  lctl XX
  rctl XX
  esc XX

  ;; caps num
  ;; caps bspc
  caps (tap-hold 0 200 bspc (layer-while-held num))
  
  ;; function layer
  ' (tap-hold 0 200 ' (layer-while-held fun))

  ;; nav layer
  lsft (tap-hold 0 120 esc (layer-while-held nav))
  rsft (tap-hold 0 120 esc (layer-while-held nav))
  / (tap-hold 0 180 / (layer-while-held nav))

  ;; symbol layer
  spc (tap-hold 0 200 spc (layer-while-held sym))
)

;; defines a vkey named v-$key, example v-bspc
;; and an alias @v-bspc that press and and releases the v-key
;; within on-press and on-release respectively.
(deftemplate v- (key)
  (defvirtualkeys (concat v- $key) $key)
  (defalias (concat v- $key)
    (multi (on-press press-vkey (concat v- $key)) (on-release release-vkey (concat v- $key))))
)

(t! v- ret)
(defchordsv2
  (d f) @v-ret 20 all-released (nav)
  
  ;; gaming toggle
  (menu esc)
    (switch
      ((layer gaming)) (layer-switch main) break
      () (layer-switch gaming) break
    )
    20 first-release ()
)

(include "nav-layer.kbd")
(include "sym-layer.kbd")
(include "gaming-layer.kbd")
(include "function-layer.kbd")
(include "num-layer.kbd")